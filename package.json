{
  "name": "camoufox-mcp",
  "version": "0.1.0",
  "description": "MCP server driving Camoufox (stealth Firefox) through the real Playwright API. Headful inspection of admin SPAs: element selectors, network JSON, humanized input.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "camoufox-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "camoufox",
    "playwright",
    "firefox",
    "stealth",
    "browser-automation",
    "vscode"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "camoufox-js": "^0.11.3",
    "playwright-core": ">=1.53.1 <1.61",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
